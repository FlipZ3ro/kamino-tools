{
  "name": "kamino-flashloan-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atomic Kamino Lend flash-loan CLI for Solana",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "cli": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "interactive": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts interactive",
    "reserves": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts reserves",
    "plan": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts plan"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "^11.0.2",
    "@solana/kit": "^2.3.0",
    "@solana/sysvars": "^2.3.0",
    "bn.js": "^5.2.2",
    "commander": "^14.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
